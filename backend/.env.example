# PostgreSQL (e.g. Neon). The pooled URL is used by the API; the unpooled one by migrations.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"
# Port the API listens on (the frontend proxies /api/* to it).
PORT=4000

# Sign-in uses accounts in the database. Create the first owner with
# `npm run user:create -w backend -- <username> "<Full name>" owner`, then add workers in Settings.
# Random string (>= 32 chars in production) used to sign session cookies, e.g. `openssl rand -base64 32`.
AUTH_SECRET=""

# How many reverse proxies sit between the internet and the API, counting the
# web app that forwards /api/* to it (so 1 when the API is only reached through
# the web app, 2 with one more proxy in front, e.g. Vercel). Sign-in throttling
# reads the client address from X-Forwarded-For using this; leave it 0 (unset)
# if the API is exposed directly, because then that header is whatever the client sends.
TRUSTED_PROXY_HOPS=0
