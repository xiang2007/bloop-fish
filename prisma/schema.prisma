// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Calendar days are stored as UTC midnight of the farm-local date
// (see lib/dates.ts) so a record never drifts across a day boundary.

// A person who can sign in. `role` decides which side of the app they get:
// "owner" (dashboard) or "worker" (daily log only). Accounts always live in
// the real schema, whichever demo scenario is showing.
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         String   @default("worker")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

// A site the ponds are grouped under on the farm map.
model Farm {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  ponds Pond[]

  @@map("farms")
}

model Pond {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  species      String?
  farmId       Int?      @map("farm_id")
  // Start of the current culture cycle ("0 Month" in the spreadsheet).
  stockedAt    DateTime? @map("stocked_at")
  stockedCount Int?      @map("stocked_count")
  // Planned length of a culture cycle, stocking to harvest.
  cycleMonths  Int       @default(8) @map("cycle_months")
  // Feed conversion ratio used to estimate biomass from feed consumed.
  assumedFcr   Float     @default(1.35) @map("assumed_fcr")
  // Weight fish should reach before harvest; drives the projected harvest date.
  targetWeightKg Float?  @map("target_weight_kg")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")

  // Physical specs, shown in the pond's spec box.
  areaM2       Float?    @map("area_m2")
  depthM       Float?    @map("depth_m")
  pondType     String?   @map("pond_type")
  waterSource  String?   @map("water_source")
  aerators     Int?
  // Owner's latest read of the water: "good", "fair" or "poor".
  waterStatus    String?   @map("water_status")
  waterNote      String?   @map("water_note")
  waterCheckedAt DateTime? @map("water_checked_at")

  farm      Farm?         @relation(fields: [farmId], references: [id], onDelete: SetNull)
  dailyLogs DailyLog[]
  samplings Sampling[]
  imports   ImportBatch[]
  cycles    PondCycle[]
  harvests  Harvest[]

  @@index([farmId])

  @@map("ponds")
}

// A finished culture cycle. The running cycle lives on the pond itself
// (stockedAt / stockedCount); closing it moves those here with a snapshot
// of its totals and leaves the pond empty until it is restocked.
model PondCycle {
  id           Int      @id @default(autoincrement())
  pondId       Int      @map("pond_id")
  number       Int
  stockedAt    DateTime @map("stocked_at")
  stockedCount Int?     @map("stocked_count")
  endedAt      DateTime @map("ended_at")
  // "harvested" or "lost" (the whole stock died).
  outcome      String
  harvestKg    Float?   @map("harvest_kg")
  // Fish harvested, or fish lost in the final event for a loss.
  fishCount    Int?     @map("fish_count")
  cause        String?
  note         String?
  feedKg       Float    @map("feed_kg")
  feedCostRm   Float    @map("feed_cost_rm")
  deadCount    Int      @map("dead_count")
  createdAt    DateTime @default(now()) @map("created_at")

  pond     Pond      @relation(fields: [pondId], references: [id], onDelete: Cascade)
  harvests Harvest[]

  @@unique([pondId, number])
  @@map("pond_cycles")
}

model FeedType {
  id         Int     @id @default(autoincrement())
  code       String  @unique
  packSizeKg Float   @map("pack_size_kg")
  pricePerKg Float   @map("price_per_kg")
  active     Boolean @default(true)

  dailyLogs      DailyLog[]
  stockMovements StockMovement[]

  @@map("feed_types")
}

// One row per pond per day, mirroring a row of the monthly feed log sheet.
model DailyLog {
  id            Int      @id @default(autoincrement())
  pondId        Int      @map("pond_id")
  date          DateTime
  feedTypeId    Int?     @map("feed_type_id")
  bags          Float    @default(0)
  // Snapshots taken when the log is saved so later price or pack-size
  // changes do not rewrite history.
  feedKg        Float    @default(0) @map("feed_kg")
  feedCostRm    Float    @default(0) @map("feed_cost_rm")
  deadCount     Int      @default(0) @map("dead_count")
  note          String?
  recordedBy    String?  @map("recorded_by")
  source        String   @default("app")
  importBatchId Int?     @map("import_batch_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  pond        Pond         @relation(fields: [pondId], references: [id], onDelete: Cascade)
  feedType    FeedType?    @relation(fields: [feedTypeId], references: [id])
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([pondId, date])
  @@index([feedTypeId])
  @@index([importBatchId])
  @@map("daily_logs")
}

// Average body weight from weighing a sample of fish.
model Sampling {
  id            Int      @id @default(autoincrement())
  pondId        Int      @map("pond_id")
  date          DateTime
  avgWeightKg   Float    @map("avg_weight_kg")
  sampleSize    Int?     @map("sample_size")
  note          String?
  recordedBy    String?  @map("recorded_by")
  source        String   @default("app")
  importBatchId Int?     @map("import_batch_id")
  createdAt     DateTime @default(now()) @map("created_at")

  pond        Pond         @relation(fields: [pondId], references: [id], onDelete: Cascade)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([pondId, date])
  @@index([importBatchId])
  @@map("samplings")
}

// Farm-level feed store. "count" is a physical stocktake that resets the
// running balance; "delivery" adds bags on top of it.
model StockMovement {
  id         Int      @id @default(autoincrement())
  feedTypeId Int      @map("feed_type_id")
  date       DateTime
  kind       String
  bags       Float
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  feedType FeedType @relation(fields: [feedTypeId], references: [id], onDelete: Cascade)

  @@index([feedTypeId, date])
  @@map("stock_movements")
}

model ImportBatch {
  id         Int      @id @default(autoincrement())
  pondId     Int      @map("pond_id")
  fileName   String   @map("file_name")
  importedAt DateTime @default(now()) @map("imported_at")
  // JSON: parsed totals and reconciliation findings, shown on the pond page.
  summary    String
  findings   String

  pond      Pond       @relation(fields: [pondId], references: [id], onDelete: Cascade)
  dailyLogs DailyLog[]
  samplings Sampling[]

  @@index([pondId])
  @@map("import_batches")
}

// One harvest event. A cycle can be harvested several times; the final
// harvest closes it. Harvests of the running cycle have no cycleId yet and
// are attached when the cycle is closed.
model Harvest {
  id         Int      @id @default(autoincrement())
  pondId     Int      @map("pond_id")
  cycleId    Int?     @map("cycle_id")
  date       DateTime
  // Sum of the size-grade lines, or boxes × box weight when not weighed.
  totalKg    Float    @map("total_kg")
  boxes      Float?
  fishCount  Int?     @map("fish_count")
  isFinal    Boolean  @default(false) @map("is_final")
  note       String?
  recordedBy String?  @map("recorded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  pond  Pond          @relation(fields: [pondId], references: [id], onDelete: Cascade)
  cycle PondCycle?    @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  lines HarvestLine[]

  @@index([pondId, date])
  @@index([cycleId])
  @@map("harvests")
}

// Weight of one size grade within a harvest.
model HarvestLine {
  id        Int   @id @default(autoincrement())
  harvestId Int   @map("harvest_id")
  gradeId   Int   @map("grade_id")
  kg        Float
  fishCount Int?  @map("fish_count")

  harvest Harvest   @relation(fields: [harvestId], references: [id], onDelete: Cascade)
  grade   SizeGrade @relation(fields: [gradeId], references: [id], onDelete: Restrict)

  @@index([harvestId])
  @@index([gradeId])
  @@map("harvest_lines")
}

// Size classes fish are sorted into at harvest, e.g. "0.8–1.2 kg".
model SizeGrade {
  id        Int     @id @default(autoincrement())
  label     String  @unique
  minKg     Float?  @map("min_kg")
  maxKg     Float?  @map("max_kg")
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  lines HarvestLine[]

  @@map("size_grades")
}

// Farm-wide settings as key/value pairs, e.g. "boxKg".
model Setting {
  key   String @id
  value String

  @@map("settings")
}
