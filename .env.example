DATABASE_URL="file:./dev.db"

# Sign-in uses accounts in the database. Create the first owner with
# `npm run user:create -- <username> "<Full name>" owner`, then add workers in Settings.
# Random string (>= 32 chars in production) used to sign session cookies, e.g. `openssl rand -base64 32`.
AUTH_SECRET=""

# How many reverse proxies sit between the internet and this app (1 on Vercel
# or behind a single nginx). Sign-in throttling reads the client address from
# X-Forwarded-For using this; leave it 0 (unset) if the app is exposed directly,
# because then that header is whatever the client sends.
TRUSTED_PROXY_HOPS=0
